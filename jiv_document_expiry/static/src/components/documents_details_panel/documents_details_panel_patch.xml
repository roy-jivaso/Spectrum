<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-name="jiv_document_expiry.DocumentsDetailsPanel"
       t-inherit="documents.DocumentsDetailsPanel"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_documents_details_panel_fields')]" position="inside">
            <t t-if="record.data.type !== 'folder'">
                <i class="fa fa-hourglass-half fa-fw mx-1 my-2" title="Track Expiry"/>
                <label class="d-flex flex-row align-items-center my-2 mb-0">
                    <input type="checkbox"
                           class="form-check-input m-0"
                           t-att-checked="record.data.track_expiry"
                           t-att-disabled="userPermissionViewOnly"
                           t-on-change="onToggleTrackExpiry"/>
                    <span class="ms-2">Track Expiry</span>
                </label>
                <t t-if="record.data.track_expiry">
                    <i class="fa fa-calendar-times-o fa-fw mx-1 my-2" title="Expiry Date"/>
                    <input type="date"
                           class="o_input w-auto my-2"
                           t-att-value="expiryDateInputValue"
                           t-att-disabled="userPermissionViewOnly"
                           t-on-change="onExpiryDateChange"/>
                </t>
            </t>
        </xpath>
    </t>

</templates>