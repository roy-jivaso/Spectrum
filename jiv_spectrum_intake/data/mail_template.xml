<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">
    <record id="email_template_intake_form" model="mail.template">
        <field name="name">Spectrum: Client Intake Form</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">Your Spectrum Home &amp; Family Care Intake Form</field>
        <field name="email_from">{{ (user.email_formatted or '') }}</field>
        <field name="email_to">{{ (object.partner_id.email or object.email_from or '') }}</field>
        <field name="body_html">
&lt;div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #333;"&gt;
    &lt;div style="background-color: #095358; padding: 24px 32px; border-radius: 8px 8px 0 0;"&gt;
        &lt;h1 style="color: #ffffff; margin: 0; font-size: 22px;"&gt;Spectrum Home &amp;amp; Family Care&lt;/h1&gt;
        &lt;p style="color: #EBE8DE; margin: 6px 0 0 0; font-size: 14px;"&gt;Client Intake Form&lt;/p&gt;
    &lt;/div&gt;
    &lt;div style="background: #ffffff; padding: 32px; border: 1px solid #e0e0e0; border-top: none;"&gt;
        &lt;p style="font-size: 15px;"&gt;Dear {{ object.partner_id.name or object.partner_name or object.contact_name or 'there' }},&lt;/p&gt;
        &lt;p style="font-size: 15px; line-height: 1.6;"&gt;
            Thank you for reaching out to Spectrum Home &amp;amp; Family Care.
            Please take a few minutes to complete our intake form so we can
            understand your needs and match you with the right caregiver.
        &lt;/p&gt;
        &lt;div style="text-align: center; margin: 32px 0;"&gt;
            &lt;a href="{{ env['ir.config_parameter'].sudo().get_param('web.base.url') }}/intake/{{ object.x_intake_token }}"
               style="background-color: #095358; color: #ffffff; padding: 14px 32px; border-radius: 6px; text-decoration: none; font-size: 16px; font-weight: bold; display: inline-block;"&gt;
                Complete My Intake Form
            &lt;/a&gt;
        &lt;/div&gt;
        &lt;p style="font-size: 13px; color: #666; line-height: 1.6;"&gt;
            This link is personal to you — please do not share it.
            It takes about 5 minutes to complete.
            One of our team members will follow up shortly after you submit.
        &lt;/p&gt;
        &lt;hr style="border: none; border-top: 1px solid #eee; margin: 24px 0;"/&gt;
        &lt;p style="font-size: 12px; color: #999; margin: 0;"&gt;
            Spectrum Home &amp;amp; Family Care &amp;nbsp;|&amp;nbsp; Confidential
        &lt;/p&gt;
    &lt;/div&gt;
&lt;/div&gt;
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</data>
</odoo>