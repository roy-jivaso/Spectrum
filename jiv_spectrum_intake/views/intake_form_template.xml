<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="intake_form_page" name="Spectrum Client Intake Form">
    <t t-call="website.layout">
        <t t-set="title">Client Intake Form — Spectrum Home &amp; Family Care</t>
        <div class="o_intake_page">
            <div class="container" style="max-width:760px; padding:32px 16px 64px;">
                <h2 class="mb-1">Client Intake Form</h2>
                <p class="text-muted mb-4">
                    Thank you for reaching out to Spectrum Home &amp; Family Care.
                    Please complete the information below so we can understand your needs
                    and match you with the right caregiver.
                    This form takes about 5 minutes — one of our team members will follow up shortly.
                </p>

                <form action="/intake/submit" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="token" t-att-value="token"/>

                    <!-- 1. Client Information -->
                    <h4 class="o_intake_section">1. Client Information</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="client_name" class="form-control"
                                   t-att-value="prefill.get('name', '')" required="required"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date of Birth</label>
                            <input type="date" name="date_of_birth" class="form-control"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Home Address</label>
                            <input type="text" name="home_address" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            <input type="tel" name="phone" class="form-control"
                                   t-att-value="prefill.get('phone', '')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" name="email" class="form-control"
                                   t-att-value="prefill.get('email', '')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Emergency Contact Name</label>
                            <input type="text" name="emergency_contact_name" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Emergency Contact Phone</label>
                            <input type="tel" name="emergency_contact_phone" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Relationship to Client</label>
                            <input type="text" name="emergency_contact_relationship" class="form-control"/>
                        </div>
                    </div>

                    <!-- 2. Funding Source -->
                    <h4 class="o_intake_section mt-4">2. How Did You Hear About Us / Funding Source</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Payer / Funding Type</label>
                            <select name="payer_type" class="form-select">
                                <option value="">-- Select --</option>
                                <t t-foreach="payer_type_options" t-as="opt">
                                    <option t-att-value="opt[0]"><t t-esc="opt[1]"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Referral Date</label>
                            <input type="date" name="referral_date" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Claim / Reference # (if applicable)</label>
                            <input type="text" name="claim_reference" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Case Manager / Specialist Name</label>
                            <input type="text" name="case_manager_name" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Case Manager Phone</label>
                            <input type="tel" name="case_manager_phone" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Case Manager Email</label>
                            <input type="email" name="case_manager_email" class="form-control"/>
                        </div>
                    </div>

                    <!-- 3. Services -->
                    <h4 class="o_intake_section mt-4">3. Services You're Interested In</h4>
                    <p class="text-muted small">Please check all that apply.</p>
                    <div class="row g-2">
                        <t t-foreach="service_types" t-as="svc">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="service_types"
                                           t-att-value="svc.x_name"
                                           t-att-id="'svc_' + str(svc.id)"/>
                                    <label class="form-check-label" t-att-for="'svc_' + str(svc.id)">
                                        <t t-esc="svc.x_name"/>
                                    </label>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Brief description of the support you're looking for</label>
                        <textarea name="service_description" class="form-control" rows="3"/>
                    </div>

                    <!-- 4. Schedule Preferences -->
                    <h4 class="o_intake_section mt-4">4. Schedule Preferences</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Desired Start Date</label>
                            <input type="date" name="desired_start_date" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estimated Hours / Week</label>
                            <input type="number" name="estimated_hours_week" class="form-control"
                                   min="0" step="0.5"/>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label d-block">Preferred Days</label>
                        <div class="d-flex flex-wrap gap-3">
                            <t t-foreach="preferred_days" t-as="day">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="preferred_days"
                                           t-att-value="day.x_name"
                                           t-att-id="'day_' + str(day.id)"/>
                                    <label class="form-check-label" t-att-for="'day_' + str(day.id)">
                                        <t t-esc="day.x_name"/>
                                    </label>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Preferred Time of Day</label>
                        <select name="preferred_time_of_day" class="form-select">
                            <option value="">-- Select --</option>
                            <t t-foreach="time_of_day_options" t-as="opt">
                                <option t-att-value="opt[0]"><t t-esc="opt[1]"/></option>
                            </t>
                        </select>
                    </div>

                    <!-- 5. Care Considerations -->
                    <h4 class="o_intake_section mt-4">5. Care Considerations</h4>
                    <p class="text-muted small">This helps us match you with a suitable caregiver — none of this is required to proceed.</p>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Mobility Needs (e.g. walker, wheelchair, transfers)</label>
                            <input type="text" name="mobility_needs" class="form-control"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Allergies or Medical Conditions</label>
                            <input type="text" name="allergies" class="form-control"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Medications Requiring Assistance / Reminders</label>
                            <input type="text" name="medications" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Caregiver Preference</label>
                            <select name="caregiver_gender_preference" class="form-select">
                                <option value="">-- Select --</option>
                                <t t-foreach="gender_pref_options" t-as="opt">
                                    <option t-att-value="opt[0]"><t t-esc="opt[1]"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Language Preference</label>
                            <input type="text" name="language_preference" class="form-control"
                                   placeholder="e.g. English, French, Punjabi"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Pets in the Home</label>
                            <input type="text" name="pets_in_home" class="form-control"
                                   placeholder="e.g. 1 dog, no cats"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Parking / Access Instructions</label>
                            <input type="text" name="access_instructions" class="form-control"/>
                        </div>
                    </div>

                    <!-- 6. Additional Care Team -->
                    <h4 class="o_intake_section mt-4">6. Additional Care Team Contacts <span class="text-muted fw-normal">(optional)</span></h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Physician Name</label>
                            <input type="text" name="physician_name" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Physician Phone</label>
                            <input type="tel" name="physician_phone" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Occupational Therapist (OT) Name</label>
                            <input type="text" name="ot_name" class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">OT Phone</label>
                            <input type="tel" name="ot_phone" class="form-control"/>
                        </div>
                    </div>

                    <!-- 7. Consent -->
                    <h4 class="o_intake_section mt-4">7. Consent</h4>
                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="consent_contact" id="consent_contact" value="1" required="required"/>
                            <label class="form-check-label" for="consent_contact">
                                I consent to Spectrum Home &amp; Family Care contacting me by phone
                                and email regarding this request.
                            </label>
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="consent_payer" id="consent_payer" value="1"/>
                            <label class="form-check-label" for="consent_payer">
                                I consent to Spectrum Home &amp; Family Care contacting the
                                case manager / payer listed above to confirm authorization and
                                funding details.
                            </label>
                        </div>
                    </div>
                    <p class="text-muted small mt-2">
                        I understand this form does not itself confirm services — a member of our
                        team will follow up to schedule a meet-and-greet and finalize a Client
                        Service Agreement.
                    </p>
                    <div class="mt-4 text-center">
                        <button type="submit" class="btn btn-primary btn-lg">
                            Submit Intake Form
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </t>
</template>

<template id="intake_thank_you" name="Intake Form — Thank You">
    <t t-call="website.layout">
        <t t-set="title">Thank You — Spectrum Home &amp; Family Care</t>
        <div class="container text-center" style="max-width:560px; padding:80px 16px;">
            <i class="fa fa-check-circle fa-5x text-success mb-3"/>
            <h2>Thank You!</h2>
            <p class="lead mt-3">
                Your intake form has been received. One of our team members
                will be in touch shortly to discuss next steps.
            </p>
            <p class="text-muted">Spectrum Home &amp; Family Care</p>
        </div>
    </t>
</template>

<template id="intake_invalid" name="Intake Form — Invalid Link">
    <t t-call="website.layout">
        <t t-set="title">Invalid Link — Spectrum Home &amp; Family Care</t>
        <div class="container text-center" style="max-width:560px; padding:80px 16px;">
            <i class="fa fa-times-circle fa-5x text-danger mb-3"/>
            <h2 class="mt-3">Link Not Found</h2>
            <p class="text-muted">
                This intake form link is invalid or has expired.
                Please contact Spectrum Home &amp; Family Care directly.
            </p>
        </div>
    </t>
</template>

<template id="intake_already_submitted" name="Intake Form — Already Submitted">
    <t t-call="website.layout">
        <t t-set="title">Already Submitted — Spectrum Home &amp; Family Care</t>
        <div class="container text-center" style="max-width:560px; padding:80px 16px;">
            <i class="fa fa-check-circle fa-5x text-success mb-3"/>
            <h2>Already Received</h2>
            <p class="lead mt-3">
                We already have your intake form on file. Our team will be in touch soon.
            </p>
            <p class="text-muted">Spectrum Home &amp; Family Care</p>
        </div>
    </t>
</template>

</odoo>
