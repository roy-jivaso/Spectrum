<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Read-only, own records, confirmed only. The state filter lives in
        the rule as well as the controller: without it, anyone who
        obtained an id could read a draft slip via RPC.
    -->
    <record id="jiv_payslip_portal_rule" model="ir.rule">
        <field name="name">Portal: own confirmed payslips</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            ['&amp;', ('employee_id.user_id', '=', user.id),
                      ('state', 'in', ['done', 'paid'])]
        </field>
    </record>

    <record id="jiv_payslip_line_portal_rule" model="ir.rule">
        <field name="name">Portal: own payslip lines</field>
        <field name="model_id" ref="hr_payroll.model_hr_payslip_line"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">
            ['&amp;', ('slip_id.employee_id.user_id', '=', user.id),
                      ('slip_id.state', 'in', ['done', 'paid'])]
        </field>
    </record>

    <record id="jiv_hr_employee_portal_payslip_rule" model="ir.rule">
        <field name="name">Portal: read own employee record (payslips)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

</odoo>
