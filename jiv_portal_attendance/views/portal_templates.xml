<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        "Attendances" card on My Account.

        Two things learned the hard way here:

        1. Cards do not sit directly under .o_portal_docs - that div only
           holds category containers. The card must go inside a specific
           category div.
        2. The category's *_enable flag is set with a t-set in the
           template, before .o_portal_docs - NOT from a controller
           override. This mirrors hr_timesheet.portal_my_home_timesheet.

        The access gate is applied in the controller (route + counter) and
        in the check-in/check-out methods, not with a t-if here: calling a
        Python method from a t-if in this template does not evaluate the
        way it does elsewhere, and a falsy result silently hides the card
        with no error.
    -->
    <template id="portal_my_home_attendance" name="Portal My Home: Attendance"
              inherit_id="portal.portal_my_home" priority="46">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/jiv_portal_attendance/static/description/attendance.svg'"/>
                <t t-set="title">Attendances</t>
                <t t-set="url" t-value="'/my/attendances'"/>
                <t t-set="text">Check in, check out and review your hours</t>
                <!--
                    config_card, not placeholder_count.

                    portal_docs_entry renders nothing unless it gets one
                    of the two: with placeholder_count the card is hidden
                    while the counter is 0 (which is exactly a new user's
                    state, so the card would only appear after they had
                    somehow already checked in), and with neither it is
                    hidden unconditionally.

                    config_card="True" is how Addresses and Connection &
                    Security stay visible for users with no records.
                -->
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <!-- Breadcrumb -->
    <template id="portal_breadcrumbs_attendance"
              inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'attendance'"
                t-attf-class="breadcrumb-item #{'active ' if not attendance else ''}">
                <a t-if="attendance" t-attf-href="/my/attendances?#{keep_query()}">
                    Attendances
                </a>
                <t t-else="">Attendances</t>
            </li>
        </xpath>
    </template>

    <!-- Attendance list page -->
    <template id="portal_my_attendances" name="My Attendances">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Attendances</t>
            </t>

            <!--
                Notification sits on its own full-width row above the
                table. Inside the button row it was clamped to a narrow
                column and long validation messages wrapped badly.
            -->
            <div t-if="notify_message"
                 t-attf-class="alert alert-#{notify_type or 'info'} alert-dismissible d-flex align-items-center"
                 role="alert">
                <i t-attf-class="fa me-2 #{'fa-check-circle' if notify_type == 'success' else 'fa-exclamation-triangle'}"/>
                <div class="flex-grow-1"><t t-out="notify_message"/></div>
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Close"/>
            </div>

            <div class="jiv-att-bar mb-3">
                <button type="button" class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#jivAttendanceModal">
                    <i class="fa fa-plus me-1"/>Create Attendance
                </button>
            </div>

            <!-- Create Attendance dialog: mirrors the backend form -->
            <div class="modal fade" id="jivAttendanceModal" tabindex="-1"
                 aria-labelledby="jivAttendanceLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <form action="/my/attendances/new" method="post"
                          class="modal-content">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>

                        <div class="modal-header">
                            <h5 class="modal-title" id="jivAttendanceLabel">
                                Create Attendance
                            </h5>
                            <button type="button" class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"/>
                        </div>

                        <div class="modal-body">
                            <div t-if="needs_recipient" class="mb-3">
                                <label class="form-label"
                                       for="jiv_recipient_id">
                                    Client / Care Recipient
                                </label>
                                <select id="jiv_recipient_id"
                                        name="recipient_id"
                                        class="form-select"
                                        required="required">
                                    <option value="">Select a client...</option>
                                    <option t-foreach="recipients" t-as="r"
                                            t-att-value="r.id"
                                            t-out="r.display_name"/>
                                </select>
                                <div t-if="not recipients"
                                     class="alert alert-warning mt-2 mb-0">
                                    No clients are available to select.
                                    Please contact your administrator.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="jiv_check_in">
                                    Check In
                                </label>
                                <input type="datetime-local" id="jiv_check_in"
                                       name="check_in" class="form-control"
                                       required="required"/>
                            </div>

                            <div class="mb-0">
                                <label class="form-label" for="jiv_check_out">
                                    Check Out
                                </label>
                                <input type="datetime-local" id="jiv_check_out"
                                       name="check_out" class="form-control"/>
                                <small class="text-muted">
                                    Leave empty if the shift is still running.
                                </small>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">Discard</button>
                            <button type="submit" class="btn btn-primary"
                                    t-att-disabled="'disabled' if (needs_recipient and not recipients) else None">
                                Save
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <t t-if="not attendances">
                <div class="alert alert-info">
                    No attendance records yet. Use Create Attendance to add one.
                </div>
            </t>

            <t t-else="">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th t-if="needs_recipient">Client</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th class="text-end">Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="attendances" t-as="att">
                            <td t-if="needs_recipient">
                                <span t-out="att[recipient_field].display_name if att[recipient_field] else ''"/>
                            </td>
                            <td>
                                <span t-field="att.check_in"
                                      t-options='{"widget": "datetime"}'/>
                            </td>
                            <td>
                                <span t-if="att.check_out" t-field="att.check_out"
                                      t-options='{"widget": "datetime"}'/>
                                <span t-else="" class="badge text-bg-success">
                                    Running
                                </span>
                            </td>
                            <td class="text-end">
                                <span t-field="att.worked_hours"
                                      t-options='{"widget": "float_time"}'/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>
        </t>
    </template>
<template id="jiv_portal_my_home_task_label"
              inherit_id="project.portal_my_home"
              name="Portal Home: Rename Tasks Card"
              priority="90">

        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-value=&quot;'/my/tasks'&quot;]]/t[@t-set='title']"
               position="replace">
            <t t-set="title">Progress Updates</t>
        </xpath>

        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-value=&quot;'/my/tasks'&quot;]]/t[@t-set='text']"
               position="replace">
            <t t-set="text">Follow and comment on progress updates in your projects</t>
        </xpath>

    </template>
</odoo>