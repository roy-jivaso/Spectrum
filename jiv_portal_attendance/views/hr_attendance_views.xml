<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="jiv_attendance_gantt_form_notes" model="ir.ui.view">
        <field name="name">hr.attendance.gantt.form.jiv.notes</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id"
               ref="hr_attendance_gantt.hr_attendance_gantt_create_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="jiv_notes_group">
                    <field name="jiv_notes" nolabel="1" colspan="2"
                           placeholder="Add notes about this shift..."/>
                </group>
            </xpath>
        </field>
    </record>



    <record id="jiv_attendance_form_notes" model="ir.ui.view">
        <field name="name">hr.attendance.form.jiv.notes</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="jiv_notes" string="Notes"
                       placeholder="Add notes about this shift..."/>
            </xpath>
        </field>
    </record>

    <!--
        Surface the portal flag so external collaborators can be told
        apart from staff and filtered out of HR reporting.
    -->
    <record id="jiv_hr_attendance_view_filter" model="ir.ui.view">
        <field name="name">hr.attendance.search.jiv.portal</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <separator/>
                <filter name="jiv_from_portal" string="From Portal"
                        domain="[('jiv_from_portal', '=', True)]"/>
                <filter name="jiv_not_from_portal" string="Internal Only"
                        domain="[('jiv_from_portal', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>
