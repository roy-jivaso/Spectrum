<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Anchored on //form with its own <app> block rather than inheriting
        another module's block id. Block ids and the app/block/setting
        nesting changed in Odoo 19, and targeting someone else's block is
        what broke the install on jiv_portal_timesheet.
    -->
    <record id="jiv_att_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.jiv.portal.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Portal Attendance"
                     string="Portal Attendance"
                     name="jiv_portal_attendance"
                     logo="/jiv_portal_attendance/static/description/attendance.svg">

                    <block title="Access"
                           name="jiv_att_access_block">
                        <setting id="jiv_att_restrict"
                                 help="Limit check-in to portal users in the Portal Attendance group. Without this, every portal user on the database can check in - including customers on unrelated projects.">
                            <field name="jiv_att_restrict_group"/>
                        </setting>
                    </block>

                    <block title="Employee Records"
                           name="jiv_att_employee_block">
                        <setting id="jiv_att_autocreate"
                                 help="Attendance requires an hr.employee. Provision one on first check-in, or create them manually.">
                            <field name="jiv_att_auto_create_employee"/>
                            <div class="content-group mt-2"
                                 invisible="not jiv_att_auto_create_employee">
                                <label for="jiv_att_employee_department_id"
                                       string="Department"
                                       class="o_light_label"/>
                                <field name="jiv_att_employee_department_id"
                                       class="oe_inline"/>
                            </div>
                        </setting>
                    </block>

                    <block title="Behaviour"
                           name="jiv_att_behaviour_block">
                        <setting id="jiv_att_login"
                                 help="Records time the user never initiated and feeds worked hours and overtime. Leave off unless the client explicitly wants login treated as arrival.">
                            <field name="jiv_att_checkin_on_login"/>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>

</odoo>
