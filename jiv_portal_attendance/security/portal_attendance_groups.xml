<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Optional gate. Only consulted when
            jiv_portal_attendance.restrict_group is enabled; otherwise
            every portal user can check in.
        -->
        <record id="group_portal_attendance" model="res.groups">
            <field name="name">Portal Attendance</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Portal users in this group may check in and
                out from the portal when access is restricted.</field>
        </record>

    </data>
</odoo>
