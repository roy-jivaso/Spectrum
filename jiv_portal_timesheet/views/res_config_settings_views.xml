<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="jiv_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.jiv.portal.timesheet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='project_time_settings']" position="inside">

                <setting id="jiv_portal_ts_approval"
                         string="Approve Portal Timesheets"
                         help="Portal entries arrive as 'To Approve' so they can be kept out of invoicing until reviewed.">
                    <field name="jiv_portal_require_approval"/>
                </setting>

                <setting id="jiv_portal_ts_employee"
                         string="Auto-create Employee for Portal Users"
                         help="Timesheet lines require an employee. Enable to provision one on first use.">
                    <field name="jiv_auto_create_employee"/>
                    <div class="content-group mt-2"
                         invisible="not jiv_auto_create_employee">
                        <label for="jiv_portal_employee_department_id"
                               string="Department" class="o_light_label"/>
                        <field name="jiv_portal_employee_department_id"
                               class="oe_inline"/>
                    </div>
                </setting>

                <setting id="jiv_portal_ts_limits" string="Portal Entry Limits">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="jiv_portal_backdate_days"
                                   string="Allowed back-dating (days)"
                                   class="col-lg-6 o_light_label"/>
                            <field name="jiv_portal_backdate_days"/>
                        </div>
                        <div class="row">
                            <label for="jiv_portal_max_hours"
                                   string="Max hours per entry"
                                   class="col-lg-6 o_light_label"/>
                            <field name="jiv_portal_max_hours"
                                   widget="float_time"/>
                        </div>
                    </div>
                </setting>

            </xpath>
        </field>
    </record>

</odoo>
