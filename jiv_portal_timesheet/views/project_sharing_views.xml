<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Makes the Timesheets tab editable in the Project Sharing form
        (/my/projects/<id>/project_sharing/<task_id>).

        The base tab is defined by
        hr_timesheet.project_sharing_inherit_project_task_view_form, which
        ships it locked at two levels:

            <field name="timesheet_ids" ... readonly="1">
                <list ... create="false" delete="0">

        Both have to be undone. High priority so this applies after
        sale_timesheet_enterprise, which inherits the same base form.
    -->


       <record id="jiv_projeddddct_sharing_task_form" model="ir.ui.view">
        <field name="name">project.task.prxoject.sharing.form.jiv.timesheet</field>
        <field name="model">project.task</field>
        <field name="inherit_id"
               ref="project.project_sharing_project_task_view_form"/>
        <field name="mode">extension</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
             <xpath expr="//field[@name='portal_user_names']" position="replace">
             <field name="x_studio_assignees"/>
             </xpath>
        </field>
       </record>
    <record id="jiv_project_sharing_task_form" model="ir.ui.view">
        <field name="name">project.task.project.sharing.form.jiv.timesheet</field>
        <field name="model">project.task</field>
        <field name="inherit_id"
               ref="hr_timesheet.project_sharing_inherit_project_task_view_form"/>
        <field name="mode">extension</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- Unlock the o2m field itself -->
            <xpath expr="//field[@name='timesheet_ids']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <!-- Unlock the embedded list and make rows inline-editable -->
            <xpath expr="//field[@name='timesheet_ids']/list" position="attributes">
                <attribute name="editable">bottom</attribute>
                <attribute name="create">1</attribute>
                <attribute name="delete">1</attribute>
            </xpath>

            <!--
                employee_id is resolved server-side in create() for portal
                users, and they cannot write it anyway. Hide the column so
                it is not an unfillable required cell.
            -->
            <xpath expr="//field[@name='timesheet_ids']/list/field[@name='employee_id']"
                   position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

            <!-- Surface the approval state so collaborators see status -->
            <xpath expr="//field[@name='timesheet_ids']/list/field[@name='unit_amount']"
                   position="after">
                <field name="jiv_portal_state" string="Status"
                       widget="badge" readonly="1" optional="show"
                       decoration-warning="jiv_portal_state == 'draft'"
                       decoration-success="jiv_portal_state == 'approved'"
                       decoration-danger="jiv_portal_state == 'refused'"/>
            </xpath>

        </field>
    </record>

</odoo>