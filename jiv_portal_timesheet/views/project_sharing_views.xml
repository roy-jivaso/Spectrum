<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Makes the Timesheets tab editable in the Project Sharing form
        (/my/projects/<id>/project_sharing/<task_id>).

        BEFORE ENABLING: find the real view id on your instance.

            v = env['ir.ui.view'].search([
                ('model', '=', 'project.task'),
                ('name', 'ilike', 'sharing'),
            ])
            for r in v:
                print(r.id, r.xml_id, r.name)

        Look for the hr_timesheet inherit that adds the Timesheets page,
        and put its xml_id in inherit_id below. The base form is
        'project.project_sharing_project_task_view_form'; the timesheet
        page is added on top of it by hr_timesheet.

        Then add this file to __manifest__.py and upgrade.
    -->
    <record id="jiv_project_sharing_task_form" model="ir.ui.view">
        <field name="name">project.task.project.sharing.form.jiv.timesheet</field>
        <field name="model">project.task</field>
        <!-- ADJUST THIS REF - see comment above -->
        <field name="inherit_id"
               ref="hr_timesheet.project_sharing_inherit_project_task_view_form"/>
        <field name="mode">extension</field>
        <field name="arch" type="xml">

            <!--
                The list is shipped read-only for portal users. Re-enable
                creation and inline editing of the rows.
            -->
            <xpath expr="//field[@name='timesheet_ids']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="options">{'no_open': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='timesheet_ids']/list" position="attributes">
                <attribute name="editable">bottom</attribute>
                <attribute name="create">1</attribute>
                <attribute name="delete">1</attribute>
            </xpath>

            <!--
                Employee is computed server-side for portal users, so hide
                the column rather than leaving an unfillable required
                field on screen.
            -->
            <xpath expr="//field[@name='timesheet_ids']/list/field[@name='employee_id']"
                   position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

        </field>
    </record>

</odoo>
