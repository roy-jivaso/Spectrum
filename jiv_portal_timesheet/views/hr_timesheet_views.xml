<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project form: enable portal timesheets per project -->
    <record id="jiv_project_form_view" model="ir.ui.view">
        <field name="name">project.project.form.jiv.portal.timesheet</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <field name="allow_timesheets" position="after">
                <field name="jiv_allow_portal_timesheet"
                       invisible="not allow_timesheets or privacy_visibility != 'portal'"/>
            </field>
        </field>
    </record>

    <!-- Timesheet list: approval state and inline approve/refuse -->
    <record id="jiv_timesheet_list_view" model="ir.ui.view">
        <field name="name">account.analytic.line.list.jiv.portal</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="arch" type="xml">
            <field name="unit_amount" position="after">
                <field name="jiv_from_portal" optional="hide"/>
                <field name="jiv_portal_state" optional="show"
                       widget="badge"
                       decoration-warning="jiv_portal_state == 'draft'"
                       decoration-success="jiv_portal_state == 'approved'"
                       decoration-danger="jiv_portal_state == 'refused'"/>
            </field>
        </field>
    </record>

    <!-- Server actions so approvers can act in bulk from the list -->
    <record id="jiv_action_approve_portal_timesheets" model="ir.actions.server">
        <field name="name">Approve Portal Timesheets</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.filtered('jiv_from_portal').action_jiv_approve()</field>
    </record>

    <record id="jiv_action_refuse_portal_timesheets" model="ir.actions.server">
        <field name="name">Refuse Portal Timesheets</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.filtered('jiv_from_portal').action_jiv_refuse()</field>
    </record>

    <!-- Filters -->
    <record id="jiv_timesheet_search_view" model="ir.ui.view">
        <field name="name">account.analytic.line.search.jiv.portal</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <separator/>
                <filter name="jiv_portal_lines" string="From Portal"
                        domain="[('jiv_from_portal', '=', True)]"/>
                <filter name="jiv_to_approve" string="Portal: To Approve"
                        domain="[('jiv_portal_state', '=', 'draft')]"/>
                <filter name="jiv_approved" string="Portal: Approved"
                        domain="[('jiv_portal_state', '=', 'approved')]"/>
            </search>
        </field>
    </record>

</odoo>
