<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
   <!--
        Stock rule lets any non-limited collaborator write EVERY task in
        the shared project. Narrow the collaborator branch to tasks the
        portal user created themselves. The follower branch is left as
        shipped so tasks explicitly shared with them stay editable.

        WARNING: this overrides a core security rule. A future Odoo
        update to project/security/project_security.xml will silently
        restore the original domain - no error, just widened access.
        Re-verify after every version upgrade.
    -->
    <record id="project.project_task_rule_portal_project_sharing"
            model="ir.rule">
        <field name="domain_force">[
            ('project_id.privacy_visibility', 'in', ['invited_users', 'portal']),
            ('active', '=', True),
            '|',
                '&amp;',
                    ('message_partner_ids', 'child_of', [user.partner_id.commercial_partner_id.id]),
                    ('project_id.collaborator_ids.partner_id', 'in', [user.partner_id.id]),
                '&amp;',
                    ('create_uid', '=', user.id),
                    ('project_id.collaborator_ids', 'any', [
                        ('partner_id', '=', user.partner_id.id),
                        ('limited_access', '=', False),
                    ]),
        ]</field>
    </record>
    <record id="jiv_task_portal_create_rule" model="ir.rule">
        <field name="name">Portal: create tasks on shared projects</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
      <field name="domain_force">[
            ('project_id.collaborator_ids', 'any', [
                ('partner_id', '=', user.partner_id.id),
                ('limited_access', '=', False),
            ])
        ]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
           <record id="jiv_project_sharing_task_tree_create" model="ir.ui.view">
        <field name="name">project.task.project.sharing.list.jiv.create</field>
        <field name="model">project.task</field>
        <field name="inherit_id"
               ref="project.project_sharing_project_task_view_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">1</attribute>
            </list>
        </field>
    </record>

    <record id="jiv_project_sharing_task_kanban_create" model="ir.ui.view">
        <field name="name">project.task.project.sharing.kanban.jiv.create</field>
        <field name="model">project.task</field>
        <field name="inherit_id"
               ref="project.project_sharing_project_task_view_kanban"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="create">1</attribute>
            </kanban>
        </field>
    </record>
    <!-- Project form: enable portal timesheets per project -->
    <record id="jiv_project_form_view" model="ir.ui.view">
        <field name="name">project.project.form.jiv.portal.timesheet</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!--
                Anchored on //sheet rather than a named field: in Odoo 19
                'allow_timesheets' is no longer rendered on this form, and
                the surrounding groups are not stable across versions.
                A form view always has a sheet.
            -->
            <xpath expr="//sheet" position="inside">
                <group name="jiv_portal_timesheet_group"
                       string="Portal Collaboration">
                    <field name="privacy_visibility" invisible="1"/>
                    <field name="jiv_allow_portal_timesheet"
                           invisible="privacy_visibility != 'portal'"/>
                    <div class="text-muted small"
                         invisible="not jiv_allow_portal_timesheet">
                        Collaborators shared with Edit access can log time at
                        /my/task/&lt;id&gt;/timesheets. Entries require approval
                        before they count as validated.
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Server actions so approvers can act in bulk from the list -->
    <record id="jiv_action_approve_portal_timesheets" model="ir.actions.server">
        <field name="name">Approve Portal Timesheets</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.filtered('jiv_from_portal').action_jiv_approve()</field>
    </record>

    <record id="jiv_action_refuse_portal_timesheets" model="ir.actions.server">
        <field name="name">Refuse Portal Timesheets</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.filtered('jiv_from_portal').action_jiv_refuse()</field>
    </record>
  </data>
</odoo>
