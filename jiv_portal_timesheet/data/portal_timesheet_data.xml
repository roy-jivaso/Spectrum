<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Defaults, so the module is functional even without the
            Settings screen (views/res_config_settings_views.xml is
            optional - see README).
            Change these in Settings > Technical > System Parameters.
        -->
        <record id="jiv_param_auto_create_employee" model="ir.config_parameter">
            <field name="key">jiv_portal_timesheet.auto_create_employee</field>
            <field name="value">True</field>
        </record>

        <record id="jiv_param_require_approval" model="ir.config_parameter">
            <field name="key">jiv_portal_timesheet.require_approval</field>
            <field name="value">True</field>
        </record>

        <record id="jiv_param_backdate_days" model="ir.config_parameter">
            <field name="key">jiv_portal_timesheet.backdate_days</field>
            <field name="value">7</field>
        </record>

        <record id="jiv_param_max_hours" model="ir.config_parameter">
            <field name="key">jiv_portal_timesheet.max_hours_per_line</field>
            <field name="value">24.0</field>
        </record>

        <!--
            Set to True on staging to show the real exception on the
            portal error banner. Leave empty/False in production.
        -->
        <record id="jiv_param_verbose_errors" model="ir.config_parameter">
            <field name="key">jiv_portal_timesheet.verbose_errors</field>
            <field name="value">True</field>
        </record>

    </data>
</odoo>
